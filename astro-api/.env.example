# Astro API settings. Copy to .env (scripts/dev_db.py setup does this and fills in passwords).
# Every value here is safe for local development only.

APP_ENV=development                     # development | test | production

# --- Postgres --------------------------------------------------------------------------------
# Three roles (see scripts/db_roles.sql). In production point the first two at PgBouncer and set
# DB_BEHIND_PGBOUNCER=true; migrations always connect directly.
DATABASE_URL=postgresql+asyncpg://astro_app:<app-password>@localhost:5433/astro
AUTH_DATABASE_URL=postgresql+asyncpg://astro_auth:<auth-password>@localhost:5433/astro
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://astro_owner:<owner-password>@localhost:5433/astro
TEST_DATABASE_NAME=astro_test
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_BEHIND_PGBOUNCER=false

# --- Redis (cache, rate limits, job queue). Empty = in-memory fallbacks, single process only.
# Required in production.
REDIS_URL=

# --- Web app ---------------------------------------------------------------------------------
WEB_ORIGIN=http://localhost:5173        # emailed links point here; writes from other origins are refused
EXTRA_ORIGINS=

# --- Sessions and one-time links ---------------------------------------------------------------
SESSION_TTL_HOURS=12
SESSION_REMEMBER_DAYS=30
VERIFY_TOKEN_HOURS=48
RESET_TOKEN_MINUTES=30

# --- Email. Empty SMTP_HOST = nothing is sent; emails appear at http://localhost:8000/api/dev/outbox
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USER=you@gmail.com, SMTP_PASSWORD=<16-letter app password>
# (Google Account > Security > 2-Step Verification > App passwords). Gmail allows about 500
# recipients a day; use Brevo, Resend or SES for real traffic.
APP_NAME=Astro
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
EMAIL_FROM=                             # empty = "APP_NAME <SMTP_USER>"
# Never email these domains for real (the demo accounts use them).
EMAIL_SUPPRESS_DOMAINS=kestrel.io,northwind.health

# --- Password hashing (Argon2id). Defaults are the library's recommended values.
ARGON2_TIME_COST=3
ARGON2_MEMORY_KIB=65536
ARGON2_PARALLELISM=4
HASH_CONCURRENCY=4

LOG_LEVEL=INFO
