# Base URL of the Astro API (FastAPI). In dev, /api is proxied to http://localhost:8000.
VITE_API_URL=/api
# true = use the built-in mock router and answers, no backend needed.
VITE_USE_MOCKS=true
# api = sign in against astro-api (run it on :8000). mock = skip sign-in, use the sample session.
VITE_AUTH=api
